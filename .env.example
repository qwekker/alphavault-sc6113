# The scripts read process.env, not .env automatically. Export values in your shell
# or use Node --env-file=.env with the relevant script. Never commit real keys.
PORT=3100
RPC_PORT=18547
# Local demonstration only:
# AUTO_KEEPER=1
# Hosted wallet-only server:
# HOST=127.0.0.1
# RPC_URL=https://YOUR_SEPOLIA_RPC
# DEPLOYMENT_FILE=./data/sepolia/deployment.json
# DB_PATH=./data/sepolia/alphavault.sqlite
# DEPLOYER_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY=
# INVESTOR_ADDRESS=
# MANAGER_ADDRESS=
# RISK_ADDRESS=
# KEEPER_ADDRESS=

# Free Render + Supabase PostgreSQL (backend secrets only; never commit values):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# DATABASE_REQUIRED=postgres
# Optional trusted CA from your database provider, PEM with literal \n separators:
# DATABASE_CA_CERT=
# INDEX_INTERVAL_MS=60000
