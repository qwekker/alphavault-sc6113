# Copy to .env.sepolia.local at project root. Public configuration only.
# Supply your own Sepolia RPC endpoint; do not paste RPC credentials into chat.
RPC_URL=https://YOUR_SEPOLIA_RPC
DEPLOYER_ADDRESS=0xYOUR_DEPLOYER
INVESTOR_ADDRESS=0xYOUR_INVESTOR
MANAGER_ADDRESS=0xYOUR_MANAGER
RISK_ADDRESS=0xYOUR_RISK_OFFICER
KEEPER_ADDRESS=0xYOUR_KEEPER
DEPLOYMENT_FILE=./data/sepolia/deployment.json
DB_PATH=./data/sepolia/alphavault.sqlite
PORT=3102
HOST=127.0.0.1
# Do not add a private key when using the browser deployment wizard.
