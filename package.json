{
  "name": "alphavault-sc6113",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "dev": "python3 scripts/demo.py",
    "start": "python3 -m gunicorn --config gunicorn.conf.py 'app:create_app()'",
    "dev:legacy": "node scripts/demo.mjs",
    "test:flask": "python3 -m pytest test_python -v",
    "keeper": "node scripts/keeper.mjs",
    "deploy:sepolia": "node --env-file-if-exists=.env.sepolia.local scripts/deploy-sepolia.mjs",
    "evidence": "node scripts/evidence.mjs",
    "check": "npm run compile && npm test",
    "setup": "node scripts/setup-server.mjs",
    "sepolia:check": "node --env-file-if-exists=.env.sepolia.local scripts/sepolia-check.mjs",
    "sepolia": "python3 app.py",
    "import:deployment": "node --env-file-if-exists=.env.sepolia.local scripts/import-deployment.mjs"
  },
  "dependencies": {
    "ethers": "6.13.5",
    "express": "4.21.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "supertest": "7.0.0"
  }
}
